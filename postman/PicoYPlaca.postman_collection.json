{
  "info": {
    "name": "PT-PicoYPlaca API",
    "description": "Coleccion de pruebas para la API de verificacion de Pico y Placa - Quito, Ecuador (AMT Res. AQ-013-2023).\n\nSelecciona el entorno 'PicoYPlaca - Local Dev' (puerto 4200) o 'PicoYPlaca - Docker' (puerto 80) antes de ejecutar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reglas",
      "item": [
        {
          "name": "GET /reglas - Obtener normativa configurada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/reglas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "reglas"]
            },
            "description": "Retorna las reglas de Pico y Placa configuradas: dias, digitos restringidos y franjas horarias."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Verificar - RESTRINGIDO",
      "item": [
        {
          "name": "Lunes 08:00 - Placa termina en 1 (NO circula)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1231\",\n  \"fechaHora\": \"2030-01-07T08:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/verificar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "verificar"]
            },
            "description": "Lunes 07/01/2030 a las 08:00. Placa termina en 1 (restringido lunes). Franja manana activa. Resultado: NO puede circular."
          },
          "response": []
        },
        {
          "name": "Lunes 09:30 - Placa termina en 2 (NO circula, limite exacto)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1232\",\n  \"fechaHora\": \"2030-01-07T09:30:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/verificar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "verificar"]
            },
            "description": "Lunes a las 09:30 exactas. El limite de la franja manana es inclusivo. Resultado: NO puede circular."
          },
          "response": []
        },
        {
          "name": "Lunes 17:00 - Placa termina en 1 (NO circula, franja tarde)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1231\",\n  \"fechaHora\": \"2030-01-07T17:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/verificar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "verificar"]
            },
            "description": "Lunes 17:00. Franja tarde activa (16:00-20:00). Resultado: NO puede circular."
          },
          "response": []
        },
        {
          "name": "Martes 08:00 - Placa termina en 3 (NO circula)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1233\",\n  \"fechaHora\": \"2030-01-08T08:00:00\"\n}"
