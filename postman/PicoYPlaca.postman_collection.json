            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1231\",\n  \"fechaHora\": \"2030-01-07T09:31:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/verificar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "verificar"]
            },
            "description": "Un minuto despues del fin de la franja manana (09:30). Resultado: SI puede circular."
          },
          "response": []
        },
