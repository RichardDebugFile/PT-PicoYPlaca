            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/verificar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "verificar"]
            },
            "description": "Martes 08/01/2030. Placa termina en 3 (restringido martes). Resultado: NO puede circular."
          },
          "response": []
        },
        {
          "name": "Viernes 06:00 - Placa termina en 0 (NO circula)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ABC-1230\",\n  \"fechaHora\": \"2030-01-11T06:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pico-placa/verificar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pico-placa", "verificar"]
            },
            "description": "Viernes 11/01/2030 a las 06:00 exactas (limite inicio franja manana, inclusivo). Placa termina en 0 (restringido viernes). Resultado: NO puede circular."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Verificar - PUEDE CIRCULAR",
      "item": [
        {
          "name": "Lunes 12:00 - Placa termina en 1 (SI circula, fuera de franja)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
